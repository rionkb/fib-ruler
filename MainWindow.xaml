<Window x:Class="FibRuler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fib Ruler" Width="1000" Height="800" Left="0" Top="0"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="True"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">
    <Canvas x:Name="OverlayCanvas"
            Background="Transparent"
            MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
            MouseMove="OverlayCanvas_MouseMove"
            MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp" />
</Window>
