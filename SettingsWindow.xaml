<Window x:Class="FibRuler.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fib Ruler Settings" Width="360" Height="230"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="#17191F" Foreground="#E8EAED"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="24">
        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Toggle shortcut" Margin="0,18,0,4" Foreground="#AEB4C0" />
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="CurrentShortcutText" VerticalAlignment="Center" FontSize="16" />
            <Button x:Name="ChangeShortcutButton" Content="Change Shortcut" Margin="18,0,0,0" Padding="12,5" Click="ChangeShortcutButton_Click" />
        </StackPanel>
        <TextBlock x:Name="HintText" Margin="0,16,0,0" Foreground="#AEB4C0" TextWrapping="Wrap" />
    </StackPanel>
</Window>
