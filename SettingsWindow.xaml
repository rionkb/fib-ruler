<Window x:Class="FibRuler.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fib Ruler Settings" Width="520" Height="720"
        MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False" Background="#17191F" Foreground="#E8EAED"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Content="← Back" Padding="10,5" Click="BackButton_Click" />
            <TextBlock Grid.Column="1" Text="Settings" Margin="16,0,0,0"
                       VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,24">

            <TextBlock Text="Shortcuts" Margin="0,22,0,10" FontSize="16" FontWeight="SemiBold" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Draw" VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CurrentDrawShortcutText" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Grid.Row="0" Grid.Column="2" x:Name="ChangeDrawShortcutButton" Content="Change" HorizontalAlignment="Left" Padding="12,5" Tag="Draw" Click="ChangeShortcutButton_Click" />
                <TextBlock Grid.Row="1" Text="Delete" Margin="0,10,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CurrentDeleteShortcutText" Margin="0,10,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Grid.Row="1" Grid.Column="2" x:Name="ChangeDeleteShortcutButton" Content="Change" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="12,5" Tag="Delete" Click="ChangeShortcutButton_Click" />
            </Grid>

            <Separator Margin="0,22,0,0" />
            <TextBlock Text="Color Settings" Margin="0,18,0,10" FontSize="16" FontWeight="SemiBold" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Base level (0.000 / 1.000)" VerticalAlignment="Center" />
                <Button Grid.Row="0" Grid.Column="1" x:Name="BaseColorButton" Tag="Base" Width="26" Height="24" Margin="8,3,0,3" Padding="0" Click="ColorSampleButton_Click" AutomationProperties.Name="Choose Base color" />
                <TextBox Grid.Row="0" Grid.Column="2" x:Name="BaseColorTextBox" MaxLength="7" Margin="8,3,0,3" TextChanged="ColorTextBox_TextChanged" />
                <TextBlock Grid.Row="1" Text="Red" VerticalAlignment="Center" />
                <Button Grid.Row="1" Grid.Column="1" x:Name="RedColorButton" Tag="Red" Width="26" Height="24" Margin="8,3,0,3" Padding="0" Click="ColorSampleButton_Click" AutomationProperties.Name="Choose Red color" />
                <TextBox Grid.Row="1" Grid.Column="2" x:Name="RedColorTextBox" MaxLength="7" Margin="8,3,0,3" TextChanged="ColorTextBox_TextChanged" />
                <TextBlock Grid.Row="2" Text="Green" VerticalAlignment="Center" />
                <Button Grid.Row="2" Grid.Column="1" x:Name="GreenColorButton" Tag="Green" Width="26" Height="24" Margin="8,3,0,3" Padding="0" Click="ColorSampleButton_Click" AutomationProperties.Name="Choose Green color" />
                <TextBox Grid.Row="2" Grid.Column="2" x:Name="GreenColorTextBox" MaxLength="7" Margin="8,3,0,3" TextChanged="ColorTextBox_TextChanged" />
                <TextBlock Grid.Row="3" Text="Orange" VerticalAlignment="Center" />
                <Button Grid.Row="3" Grid.Column="1" x:Name="OrangeColorButton" Tag="Orange" Width="26" Height="24" Margin="8,3,0,3" Padding="0" Click="ColorSampleButton_Click" AutomationProperties.Name="Choose Orange color" />
                <TextBox Grid.Row="3" Grid.Column="2" x:Name="OrangeColorTextBox" MaxLength="7" Margin="8,3,0,3" TextChanged="ColorTextBox_TextChanged" />
                <TextBlock Grid.Row="4" Text="Cyan" VerticalAlignment="Center" />
                <Button Grid.Row="4" Grid.Column="1" x:Name="CyanColorButton" Tag="Cyan" Width="26" Height="24" Margin="8,3,0,3" Padding="0" Click="ColorSampleButton_Click" AutomationProperties.Name="Choose Cyan color" />
                <TextBox Grid.Row="4" Grid.Column="2" x:Name="CyanColorTextBox" MaxLength="7" Margin="8,3,0,3" TextChanged="ColorTextBox_TextChanged" />
                <TextBlock Grid.Row="5" Text="Blue" VerticalAlignment="Center" />
                <Button Grid.Row="5" Grid.Column="1" x:Name="BlueColorButton" Tag="Blue" Width="26" Height="24" Margin="8,3,0,3" Padding="0" Click="ColorSampleButton_Click" AutomationProperties.Name="Choose Blue color" />
                <TextBox Grid.Row="5" Grid.Column="2" x:Name="BlueColorTextBox" MaxLength="7" Margin="8,3,0,3" TextChanged="ColorTextBox_TextChanged" />
                <TextBlock Grid.Row="6" Text="Purple" VerticalAlignment="Center" />
                <Button Grid.Row="6" Grid.Column="1" x:Name="PurpleColorButton" Tag="Purple" Width="26" Height="24" Margin="8,3,0,3" Padding="0" Click="ColorSampleButton_Click" AutomationProperties.Name="Choose Purple color" />
                <TextBox Grid.Row="6" Grid.Column="2" x:Name="PurpleColorTextBox" MaxLength="7" Margin="8,3,0,3" TextChanged="ColorTextBox_TextChanged" />
                <TextBlock Grid.Row="7" Text="Pink" VerticalAlignment="Center" />
                <Button Grid.Row="7" Grid.Column="1" x:Name="PinkColorButton" Tag="Pink" Width="26" Height="24" Margin="8,3,0,3" Padding="0" Click="ColorSampleButton_Click" AutomationProperties.Name="Choose Pink color" />
                <TextBox Grid.Row="7" Grid.Column="2" x:Name="PinkColorTextBox" MaxLength="7" Margin="8,3,0,3" TextChanged="ColorTextBox_TextChanged" />
            </Grid>

            <TextBlock Text="Band Opacity" Margin="0,18,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" x:Name="BandOpacitySlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.05" ValueChanged="BandOpacitySlider_ValueChanged" />
                <TextBlock Grid.Column="1" x:Name="BandOpacityText" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <Button Content="Reset to TradingView Colors" Margin="0,16,0,0" HorizontalAlignment="Left" Padding="12,5" Click="ResetColorsButton_Click" />

            <TextBlock x:Name="HintText" Margin="0,18,0,0" Foreground="#AEB4C0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
