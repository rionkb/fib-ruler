<Window x:Class="FibRuler.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fib Ruler" Width="400" Height="300"
        MinWidth="360" MinHeight="260" MaxWidth="460" MaxHeight="340"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="True" Topmost="False" Background="#17191F" Foreground="#E8EAED"
        Loaded="Window_Loaded">
    <Border Padding="24" BorderBrush="#30343D" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="52" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Fib Ruler" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Grid.Row="1" x:Name="StatusText" Margin="0,8,0,14" FontSize="18" FontWeight="SemiBold" Foreground="#AEB4C0" />
            <Button Grid.Row="2" x:Name="ToggleButton" Height="46" Click="ToggleButton_Click" FontSize="16" />

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Draw" Foreground="#AEB4C0" />
                    <TextBlock Text="Delete" Margin="0,6,0,0" Foreground="#AEB4C0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock x:Name="DrawShortcutText" FontWeight="SemiBold" />
                    <TextBlock x:Name="DeleteShortcutText" Margin="0,6,0,0" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="4" x:Name="HotkeyErrorText" Margin="0,14,0,0"
                       VerticalAlignment="Bottom"
                       Foreground="#FF8A80" TextWrapping="Wrap" Visibility="Collapsed" />

            <Button Grid.Row="5" HorizontalAlignment="Right" Content="Settings" Padding="14,5" Click="SettingsButton_Click" />
        </Grid>
    </Border>
</Window>
