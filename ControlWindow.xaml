<Window x:Class="FibRuler.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fib Ruler" Width="380" Height="270"
        MinWidth="340" MinHeight="220" MaxWidth="420" MaxHeight="280"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        ShowInTaskbar="True" Topmost="False" Background="#17191F" Foreground="#E8EAED"
        Loaded="Window_Loaded">
    <Border Padding="24" BorderBrush="#30343D" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Fib Ruler" FontSize="24" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Margin="0,8,0,14" FontSize="18" FontWeight="SemiBold" Foreground="#AEB4C0" />
            <Button x:Name="ToggleButton" Height="46" Click="ToggleButton_Click" FontSize="16" />
            <TextBlock Margin="0,10,0,0" Text="Draw: Shift + A    Delete: Shift + D" Foreground="#AEB4C0" FontSize="12" />
            <DockPanel Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="Settings" Padding="14,5" Click="SettingsButton_Click" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Toggle shortcut:" Foreground="#AEB4C0" VerticalAlignment="Center" />
                    <TextBlock x:Name="ShortcutText" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
