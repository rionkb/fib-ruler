<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\FibRuler.ico</ApplicationIcon>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
    <Product>Fib Ruler</Product>
    <Description>A lightweight Fibonacci overlay ruler for Windows.</Description>
    <AssemblyTitle>Fib Ruler</AssemblyTitle>
    <AssemblyDescription>A lightweight Fibonacci overlay ruler for Windows.</AssemblyDescription>
  </PropertyGroup>

</Project>
